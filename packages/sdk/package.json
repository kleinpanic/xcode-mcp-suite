{
  "name": "@kleinpanic/xcode-mcp-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Xcode's MCP bridge (xcrun mcpbridge)",
  "license": "MIT",
  "author": "kleinpanic",
  "repository": { "type": "git", "url": "https://github.com/kleinpanic/xcode-mcp-suite" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "*",
    "@types/node": "*"
  }
}
